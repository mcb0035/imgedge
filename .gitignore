# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
build/

# Test / coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# Models & datasets (downloaded or generated — large, not source)
models/
data/
runs/
*.tflite
*.onnx
*.mlmodel
*.pt

# ImgEdge local state (defaults live in $HOME; ignored here in case they're
# pointed at the repo via IMGEDGE_TOKEN_FILE / IMGEDGE_CACHE_FILE)
.imgedge_token
.imgedge_cache.json
*.part

# Extension packaging output (package.ps1). *.pem is the CRX signing key —
# never commit it.
dist/
*.crx
*.pem

# Evaluation harness (local-only): encrypted datasets, raw image collections,
# and reports. These can reference the very images the extension exists to
# hide, so they must never be committed.
*.eval.zip
/eval-raw/
/eval-data/
# report files written by `eval_filter.py eval --report ...`: the default
# eval-report*.json plus dataset-named reports (inat*.json / oi*.json).
/eval-report*.json
/inat*.json
/oi*.json

# JS tooling (ESLint)
node_modules/

# OS / editor
.DS_Store
Thumbs.db
